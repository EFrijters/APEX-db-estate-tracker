authorization administration-rights (
    name: Administration Rights
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return true;
    }
    error {
        errorMessage: Insufficient privileges, user is not an Administrator
    }
)

authorization is-dba (
    name: Is DBA
    type: isInRoleOrGroup
    settings {
        names: DBA
    }
    error {
        errorMessage: You need the DBA role for this action.
    }
    advanced {
        evaluationType: perSession
    }
)

authorization is-reader-or-dba (
    name: Is reader or DBA
    type: isInRoleOrGroup
    settings {
        names: [
            READER
            DBA
        ]
    }
    error {
        errorMessage: You need the READER or DBA role for this action.
    }
    advanced {
        evaluationType: perSession
    }
)

