list navigation-menu (
    name: Navigation Menu

    entry database-patches (
        label: Database patches
        icon {
            imageIconCssClasses: fa-layout-header-sidebar-left
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 5
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry ig-customers (
        label: IG_Customers
        icon {
            imageIconCssClasses: fa-table-pointer
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 4
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry ir-servers (
        label: IR_Servers
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: [
                6
                7
            ]
        }
        link {
            target: {
                page: 6
            }
        }
    )

    entry table-databases (
        label: Table_Databases
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                2
                3
            ]
        }
        link {
            target: {
                page: 2
            }
        }
    )

)

