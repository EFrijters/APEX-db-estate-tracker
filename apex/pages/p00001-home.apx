page 1 (
    name: Home
    alias: HOME
    title: DB Estate Tracker
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region db-estate-tracker (
        name: DB Estate Tracker
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

)

