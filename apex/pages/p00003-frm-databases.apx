page 3 (
    name: Frm_databases
    alias: FRM-DATABASES
    title: Frm_databases
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region frm-databases (
        name: Frm_databases
        type: form
        source {
            location: localDatabase
            tableName: DATABASES
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P3_CREATED (
        type: displayOnly
        label {
            label: Created
            alignment: left
        }
        layout {
            sequence: 90
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @frm-databases
            column: CREATED
            dataType: date
            queryOnly: true
        }
    )

    pageItem P3_CREATED_BY (
        type: displayOnly
        label {
            label: Created By
            alignment: left
        }
        layout {
            sequence: 100
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @frm-databases
            column: CREATED_BY
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P3_DB_NAME (
        type: textField
        label {
            label: Db Name
            alignment: right
        }
        layout {
            sequence: 30
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @frm-databases
            column: DB_NAME
            dataType: varchar2
        }
    )

    pageItem P3_EDITION (
        type: textField
        label {
            label: Edition
            alignment: right
        }
        layout {
            sequence: 50
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @frm-databases
            column: EDITION
            dataType: varchar2
        }
    )

    pageItem P3_GO_LIVE_DATE (
        type: datePicker
        label {
            label: Go Live Date
            alignment: right
        }
        layout {
            sequence: 70
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @frm-databases
            column: GO_LIVE_DATE
            dataType: date
        }
    )

    pageItem P3_ID (
        type: hidden
        layout {
            sequence: 10
            region: @frm-databases
            slot: regionBody
        }
        source {
            formRegion: @frm-databases
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_IS_CDB (
        type: switch
        label {
            label: Is Cdb
            alignment: right
        }
        layout {
            sequence: 60
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @frm-databases
            column: IS_CDB
            dataType: boolean
        }
        sessionState {
            dataType: boolean
        }
    )

    pageItem P3_ROW_VERSION (
        type: hidden
        layout {
            sequence: 80
            region: @frm-databases
            slot: regionBody
        }
        source {
            formRegion: @frm-databases
            column: ROW_VERSION
            dataType: number
        }
    )

    pageItem P3_SERVER_ID (
        type: selectList
        label {
            label: Server
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @lov-servers
        }
        layout {
            sequence: 20
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @frm-databases
            column: SERVER_ID
            dataType: number
        }
    )

    pageItem P3_UPDATED (
        type: displayOnly
        label {
            label: Updated
            alignment: left
        }
        layout {
            sequence: 110
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @frm-databases
            column: UPDATED
            dataType: date
            queryOnly: true
        }
    )

    pageItem P3_UPDATED_BY (
        type: displayOnly
        label {
            label: Updated By
            alignment: left
        }
        layout {
            sequence: 120
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @frm-databases
            column: UPDATED_BY
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P3_VERSION (
        type: textField
        label {
            label: Version
            alignment: right
        }
        layout {
            sequence: 40
            region: @frm-databases
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @frm-databases
            column: VERSION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
    )

    validation db-name-unique-per-server (
        name: DB name unique per server
        execution {
            sequence: 20
        }
        validation {
            type: noRowsReturned
            sqlQuery:
                ```sql
                SELECT 1
                  FROM databases
                  WHERE db_name = UPPER(:P3_DB_NAME) AND    
                    server_id = :P3_SERVER_ID AND
                    id <> NVL(:P3_ID, -1)
                ```
        }
        error {
            errorMessage: Database &P3_DB_NAME. already exists on this server.
            associatedItem: @P3_DB_NAME
        }
    )

    validation go-live-not-in-future (
        name: Go-live not in future
        execution {
            sequence: 10
        }
        validation {
            plsqlExpression: :P3_GO_LIVE_DATE IS NULL OR TRUNC(TO_DATE(:P3_GO_LIVE_DATE)) <= TRUNC(SYSDATE)
        }
        error {
            errorMessage: Go-live date cannot be in the future.
            associatedItem: @P3_GO_LIVE_DATE
        }
    )

    computation p3-db-name (
        itemName: P3_DB_NAME
        execution {
            sequence: 10
            point: afterSubmit
        }
        computation {
            type: expression
            plsqlExpression: UPPER(:P3_DB_NAME)
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 6213374889627197
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-frm-databases (
        name: Initialize form Frm_databases
        type: formInitialization
        formRegion: @frm-databases
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 6212522663627197
        }
    )

    process log-version-change (
        name: Log version change
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                  l_old_version databases.version%TYPE;
                BEGIN
                  IF :P3_ID IS NOT NULL THEN
                    SELECT version INTO l_old_version
                      FROM   databases
                      WHERE  id = :P3_ID;
                
                    IF NVL(l_old_version, '#') <> NVL(:P3_VERSION, '#') THEN
                      INSERT INTO patches (database_id, patch_name, applied_on, applied_by)
                        VALUES (:P3_ID, 'Version change ' || l_old_version || ' -> ' || :P3_VERSION, SYSDATE, :APP_USER);
                    END IF;
                  END IF;
                END;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 7000768925689607
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process process-form-frm-databases (
        name: Process form Frm_databases
        type: formAutoRowProcessing
        formRegion: @frm-databases
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 6212942623627197
        }
    )

)

